<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add new category</title>
  <script src="/scripts/category/addCategory.js" defer></script>
  <link rel="stylesheet" href="/style/category/addCategory.css">

</head>

<body>
  <%- include('../components/navbar.ejs') %>
  <form action="/categories" method="POST" id="editForm" class="form">
    <h2>Add a category:</h2>
    <div id="errorPanel" class="form__error-panel"></div>
    <div class="form__input-wrapper form__input-wrapper--required">
      <label for="category">Category:</label>
      <input type="text" name="categoryName" id="categoryName" required />
    </div>

    <button type="submit" class="form__button-add">Add</button>
  </form>
</body>


</html>