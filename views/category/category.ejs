<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Category: <%= category.category %></title>
  <link rel="stylesheet" href="/style/category/category.css">

</head>

<body>
  <%- include('../components/navbar.ejs') %>
  <div class="wrapper">
    <h2>Category: <%= category.category %></h2>

    <a href="/categories/<%=category.category_id%>/edit">Edit category</a>

    <% if(items.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th class="table__header-number">No.</th>
          <th class="table__header-generic">Model</th>
          <th class="table__header-generic">Producer</th>
          <th class="table__header-generic">Quantity</th>
        </tr>
      </thead>
      <tbody>
        <% items.map((item,index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td> <%= item.model %> </td>
          <td> <%= item.producer_name %> </td>
          <td> <%= item.quantity %> </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } else { %>
    <p>No items in this category</p>
    <% } %>
  </div>
</body>

</html>