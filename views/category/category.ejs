<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Category: <%= category.category %></title>
</head>

<body>
  <%- include('../components/navbar.ejs') %>
  <div>
    <h2>Category: <%= category.category %></h2>
    <a href="/categories/<%=category.category_id%>/edit">Edit</a>

    <% if(items.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>Model</th>
          <th>Producer</th>
          <th>Quantity</th>
        </tr>
      </thead>
      <tbody>
        <% items.map((item) => { %>
        <tr>
          <td> <%= item.model %> </td>
          <td> <%= item.producer_name %> </td>
          <td> <%= item.quantity %> </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <span>Results: <%= items.length %> </span>
    <% } else { %>
    <p>No items in this category</p>
    <% } %>
  </div>
</body>

</html>