<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit category: <%=categoryInfo.category%></title>
  <script src="/scripts/category/editCategory.js" defer></script>
  <link rel="stylesheet" href="/style/category/editCategory.css">

</head>

<body>
  <%- include('../components/navbar.ejs') %>

  <div>
    <div id="errorPanel">

    </div>
    <form id="editForm" action="/" method="POST" class="form">
      <h2>Edit a category:</h2>

      <div class="form__input-wrapper form__input-wrapper--required">
        <label for="newCategory">Category:</label>
        <input type="text" name="newCategory" id="newCategory" value="<%= categoryInfo.category%>" required />
      </div>

      <button type="submit" class="form__button-add">Save</button>
    </form>
  </div>
</body>

</html>