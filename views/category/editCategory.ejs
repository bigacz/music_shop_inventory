<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit category: <%=categoryInfo.category%></title>
  <script src="/scripts/category/editCategory.js" defer></script>
</head>

<body>
  <%- include('../components/navbar.ejs') %>

  <div>
    <div id="errorPanel">

    </div>
    <form id="editForm" action="/" method="POST">
      <label for="newCategory">Category:</label>
      <input type="text" name="newCategory" id="newCategory" value="<%= categoryInfo.category%>" required />

      <button type="submit">Save</button>
    </form>
  </div>
</body>

</html>