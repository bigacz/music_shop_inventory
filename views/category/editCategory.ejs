<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit category: <%=categoryInfo.category%></title>
</head>

<body>
  <%- include('../components/navbar.ejs') %>

  <div>
    <div id="errorPanel">

    </div>
    <form id="editForm" action="/" method="POST">
      <label for="newCategory">Category:</label>
      <input type="text" name="newCategory" id="newCategory" value="<%= categoryInfo.category%>" />

      <button type="submit">Save</button>
    </form>
  </div>
</body>
<script>
  const errorPanel = document.getElementById('errorPanel');

  const form = document.getElementById('editForm');
  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    try {
      const response = await fetch('/categories/<%=categoryInfo.category_id%>', {
        method: 'PATCH',
        body: new URLSearchParams(new FormData(event.target)),
      })


      if (response.status == 400) {
        errorPanel.innerHTML = ''

        const errors = await response.json();

        errors.forEach((error) => {
          const errorNode = document.createElement('li')
          errorNode.textContent = error.msg;

          errorPanel.append(errorNode);
        })
      }

      if (!response.ok) {
        throw response
      }


      window.location.pathname = 'categories/<%=categoryInfo.category_id%>'
    } catch (error) {
      console.log(error);
    }
  })
</script>

</html>