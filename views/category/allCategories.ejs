<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>All Categories</title>
</head>

<body>
  <%- include('../components/navbar.ejs') %>
  <h2>All Categories:</h2>
  <div>
    <% categories.map((category) => { %>
    <div>
      <span> <a href="categories/<%= category.category_id %>"> <%= category.category %></a> </span>
      <button onclick="(async () => {
                try {
                  const response = await fetch('/categories/<%=category.category_id%>', {
                    method: 'DELETE',
                  });
                  
                  let json;
                  if(!response.ok) {
                    if(response.headers.get('content-type').includes('application/json') ) {
                      json = await response.json();
                      if(json.errors.length > 0) {
                        return console.error(json.errors);
                      } else {
                        return console.error(`Couldn't delete category`)
                      }
                    }

                  }
                  
                  window.location.reload();
                } catch (error) {
                  console.error(error);
                  console.log(`Something went wrong`);
                }
                
              })()">DELETE</button>

      <a href="/categories/<%=category.category_id%>/edit">Edit</a>
    </div>
    <% }) %>
  </div>
</body>

</html>