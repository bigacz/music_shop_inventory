<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>All Categories</title>
  <script src="/scripts/category/allCategories.js" defer></script>
  <link rel="stylesheet" href="/style/category/allCategories.css">

</head>

<body>
  <%- include('../components/navbar.ejs') %>
  <div>
    <h2>All Categories:</h2>
    <table>
      <thead>
        <tr>
          <th class="table__header-number">No.</th>
          <th class="table__header-generic">Name</th>
          <th class="table__header-delete">Delete</th>
          <th>Edit</th>
        </tr>
      </thead>
      <tbody>

        <% categories.map((category, index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td> <a href="categories/<%= category.category_id %>"> <%= category.category %></a> </td>
          <td class="table__delete-cell">
            <button data-category-id="<%= category.category_id%>">
              <img src="/assets/delete.svg" alt="Delete">
            </button>
          </td>
          <td class="table__edit-cell">
            <a href="/categories/<%=category.category_id%>/edit">
              <img src="/assets/cog.svg" alt="Edit">
            </a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>

</html>