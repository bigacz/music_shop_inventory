<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>All Categories</title>
  <script src="/scripts/category/allCategories.js" defer></script>
</head>

<body>
  <%- include('../components/navbar.ejs') %>
  <h2>All Categories:</h2>
  <div>
    <% categories.map((category) => { %>
    <div>
      <span> <a href="categories/<%= category.category_id %>"> <%= category.category %></a> </span>
      <button data-category-id="<%= category.category_id%>">DELETE</button>

      <a href="/categories/<%=category.category_id%>/edit">Edit</a>
    </div>
    <% }) %>
  </div>
</body>

</html>