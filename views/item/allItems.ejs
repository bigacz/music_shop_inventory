<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>All Items</title>
  <link rel="stylesheet" href="style/allItems.css">
  <script src="/scripts/item/allItems.js" defer></script>
  <link rel="stylesheet" href="/style/item/allItems.css">

</head>

<body>
  <%- include('../components/navbar.ejs') %>
  <div>
    <h2>All items:</h2>
    <table>
      <thead>
        <tr>
          <th class="table__header-number">No.</th>
          <th class="table__header-generic">Model</th>
          <th class="table__header-generic">Producer</th>
          <th class="table__header-generic">Category</th>
          <th class="table__header-quantity">Quantity</th>
          <th class="table__header-delete">Delete</th>
          <th>Edit</th>
        </tr>
      </thead>
      <tbody>
        <% allItems.map((item, index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td> <a href="/items/<%= item.item_id%>"><%= item.model %></a> </td>
          <td> <a href="/producers/<%= item.producer_id%>"><%= item.producer_name %></a> </td>
          <td> <a href="/categories/<%= item.category_id%>"><%= item.category %></a> </td>
          <td> <%= item.quantity %> </td>
          <td class="table__delete-cell">
            <button data-item-id="<%=item.item_id%>">
              <img src="/assets/delete.svg" alt="Delete">
            </button>
          </td>
          <td class="table__edit-cell">
            <a href="items/<%=item.item_id%>/edit"><img src="/assets/cog.svg" alt="Edit"></a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

</body>

</html>