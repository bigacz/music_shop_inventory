<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= `${item.model} ${item.producer_name}` %></title>
</head>

<body>
  <%- include('../components/navbar.ejs') %>
  <div>
    <table>
      <thead>
        <tr>
          <th>Model</th>
          <th>Producer</th>
          <th>Category</th>
          <th>Quantity</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= item.model %></td>
          <td>
            <a href="/producers/<%= item.producer_id%>"><%= item.producer_name %></a>
          </td>
          <td>
            <a href="/categories/<%= item.category_id%>"><%= item.category %></a>
          </td>
          <td><%= item.quantity %></td>
          <td>
            <button onclick="(async () => {
                await fetch(`/items/<%= item.item_id%>`, {
                  method: 'DELETE',
                })
                
                window.location.pathname = '/items'
              })()">
              DELETE
            </button>
            <button><a href="./<%=item.item_id%>/edit">Edit</a></button>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</body>

</html>