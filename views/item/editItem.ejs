<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit item: <%=item.model%></title>
  <script src="/scripts/item/editItem.js" defer></script>
  <link rel="stylesheet" href="/style/item/editItem.css">

</head>

<body>
  <%- include('../components/navbar.ejs') %>
  <div>
    <form id="editForm" class="form">
      <h2>Edit an item:</h2>
      <div id="errorPanel" class="form__error-panel"></div>

      <div class="form__input-wrapper form__input-wrapper--required">
        <label for="newModel">Model:</label>
        <input type="text" name="newModel" id="newModel" value="<%=item.model%>" required />
      </div>

      <div class="form__input-wrapper form__input-wrapper--required">
        <label for="newCategoryId">Category:</label>
        <select name="newCategoryId" id="newCategoryId" required>
          <% categories.forEach((category) => { %>
          <option value="<%=category.category_id%>" <%= item.category_id == category.category_id ? 'selected' : null %>>
            <%=category.category%>
          </option>
          <%}) %>
        </select>
      </div>

      <div class="form__input-wrapper form__input-wrapper--required">
        <label for="newProducerId">Producer:</label>
        <select name="newProducerId" id="newProducerId" required>
          <% producers.forEach((producer) => { %>
          <option value="<%=producer.producer_id%>" <%= item.producer_id == producer.producer_id ? 'selected' : null %>>
            <%=producer.producer_name%>
          </option>
          <%}) %>
        </select>
      </div>

      <div class="form__input-wrapper form__input-wrapper--required">
        <label for="newQuantity">Quantity:</label>
        <input type="number" name="newQuantity" id="newQuantity" value="<%=item.quantity%>" min="1" required />
      </div>

      <input type="hidden" name="itemId" value="<%= item.item_id%>">

      <button type="submit" class="form__button-add">Save</button>
    </form>
  </div>
</body>

</html>