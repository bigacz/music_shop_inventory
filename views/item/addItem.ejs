<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add new item</title>
  <script src="/scripts/item/addItem.js" defer></script>
  <link rel="stylesheet" href="/style/item/addItem.css">


</head>

<body>
  <%- include('../components/navbar.ejs') %>
  <h2>Add an item:</h2>
  <form action="/items" method="POST" id="addForm">
    <div id="errorPanel"></div>

    <label for="model">Model:</label>
    <input type="text" name="model" id="model" required />

    <label for="categoryId">Category:</label>
    <select name="categoryId" id="categoryId" required>
      <% categories.forEach((category) => { %>
      <option value="<%=category.category_id%>">
        <%=category.category%>
      </option>
      <%}) %>
    </select>

    <label for="producerId">Producer:</label>
    <select name="producerId" id="producerId" required>
      <% producers.forEach((producer) => { %>
      <option value="<%=producer.producer_id%>">
        <%=producer.producer_name%>
      </option>
      <%}) %>
    </select>

    <label for="quantity">Quantity:</label>
    <input type="number" name="quantity" id="quantity" min="1" required />

    <button type="submit">Add</button>
  </form>
</body>

</html>