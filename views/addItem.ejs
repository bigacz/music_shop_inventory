<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add new item</title>
  </head>
  <body>
    <%- include('components/navbar.ejs') %>
    <h2>Add an item:</h2>
    <form action="/items" method="POST">
      <label for="model">Model:</label>
      <input type="text" name="model" id="model" />

      <label for="category">Category:</label>
      <input type="text" name="category" id="category" list="category_datalist" />
      <datalist id="category_datalist">
        <% categories.map((category) => { %>
          <option value="<%= category.category %>"/>
        <% }) %>
      </datalist>

      <label for="producer">Producer:</label>
      <input type="text" name="producer" id="producer" list="producer_datalist" />
      <datalist id="producer_datalist">
        <% producers.map((producer) => { %>
          <option value="<%= producer.producer_name %>"/>
        <% }) %>
      </datalist>

      <label for="quantity">Quantity:</label>
      <input type="number" name="quantity" id="quantity" />

      <button type="submit">Add</button>
    </form>
  </body>
</html>
