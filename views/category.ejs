<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Category: <%= items[0].category %></title>
  </head>
  <body>
    <%- include('components/navbar.ejs') %>
    <h2>All Categories:</h2>
    <div>
      <h2>Category: <%= items[0].category %></h2>
      
      <table>
        <thead>
          <tr>
            <th>Model</th>
            <th>Producer</th>
            <th>Quantity</th>
          </tr>
        </thead>
        <tbody>
          <% items.map((item) => { %>
            <tr>
              <td> <%= item.model %> </td> 
              <td> <%= item.producer_name %> </td>
              <td> <%= item.quantity %> </td>
            </tr>
        </tbody>
            <% }) %>
      </table>
      <span>Results: <%= items.length %>  </span>
    </div>
  </body>
</html>
