<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Producer: <%= producerInfo.producer_name %></title>

  <script src="/scripts/producer/producer.js" defer></script>
  <link rel="stylesheet" href="/style/producer/producer.css">


</head>

<body>
  <%- include('../components/navbar.ejs') %>
  <div class="main-wrapper">
    <div class="producer-info">
      <h2>Producer: <%= producerInfo.producer_name %></h2>
      <p><span class="span-bold">Location:</span> <%= producerInfo.location %></p>
      <p><span class="span-bold">Email:</span> <%= producerInfo.email %></p>
      <div class="button-wrapper">
        <button id="deleteButton" class="button-delete" data-producer-id="<%=producerInfo.producer_id%>">Delete</button>
        <a class="link-edit" href="./<%=producerInfo.producer_id%>/edit">Edit</a>
      </div>
    </div>

    <% if(items.length > 0) { %>
    <table>
      <span>Items from this producer:</span>
      <thead>
        <tr>
          <th class="table__header-number">No.</th>
          <th class="table__header-generic">Model</th>
          <th class="table__header-generic">Category</th>
          <th class="table__header-quantity">Quantity</th>
        </tr>
      </thead>
      <tbody>
        <%  items.map((item, index) => { %>
        <tr>
          <td><%= index + 1 %></td>

          <td> <%= item.model %> </td>
          <td> <%= item.category %> </td>
          <td> <%= item.quantity %> </td>
        </tr>
      </tbody>
      <% }) %>
    </table>

    <% } else { %>
    <p>No items from this producer</p>
    <% } %>
  </div>
</body>

</html>