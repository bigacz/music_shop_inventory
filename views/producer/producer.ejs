<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Producer: <%= producerInfo.producer_name %></title>
</head>

<body>
  <%- include('../components/navbar.ejs') %>
  <div>
    <h2>Producer: <%= producerInfo.producer_name %></h2>
    <p>Location: <%= producerInfo.location %></p>
    <p>Email: <%= producerInfo.email %></p>
    <button><a href="./<%=producerInfo.producer_id%>/edit">Edit</a></button>

    <% if(items.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>Model</th>
          <th>Category</th>
          <th>Quantity</th>
        </tr>
      </thead>
      <tbody>
        <%  items.map((item) => { %>
        <tr>
          <td> <%= item.model %> </td>
          <td> <%= item.category %> </td>
          <td> <%= item.quantity %> </td>
        </tr>
      </tbody>
      <% }) %>
    </table>
    <span>Results: <%= items.length %> </span>

    <% } else { %>
    <p>No items from producer</p>
    <% } %>
  </div>
</body>

</html>