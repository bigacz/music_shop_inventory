<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit producer: <%= producerInfo.producer_name %></title>

  <script src="/scripts/producer/editProducer.js" defer></script>

</head>

<body>
  <%- include('../components/navbar.ejs') %>
  <div>
    <form id="editForm" action="/" method="POST">
      <div id="errorPanel"></div>
      <label for="newProducer">Producer:</label>
      <input type="text" name="newProducer" id="newProducer" value="<%= producerInfo.producer_name%>" required />

      <label for="newEmail">E-mail:</label>
      <input type="email" name="newEmail" id="newEmail" value="<%= producerInfo.email%>" required />

      <label for="newLocation">Location:</label>
      <input type="text" name="newLocation" id="newLocation" value="<%= producerInfo.location %>" required />

      <input type="hidden" name="producerId" value="<%= producerInfo.producer_id%>">


      <button type="submit">Save</button>
    </form>
  </div>
</body>


</html>