<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add new producer</title>
  <script src="/scripts/producer/addProducer.js" defer></script>
  <link rel="stylesheet" href="/style/producer/addProducer.css">


</head>

<body>
  <%- include('../components/navbar.ejs') %>
  <h2>Add a producer:</h2>
  <form action="/producers" method="POST" id="addForm">
    <div id="errorPanel"></div>
    <label for="producer">Producer:</label>
    <input type="text" name="producer" id="producer" required />

    <label for="email">E-mail:</label>
    <input type="email" name="email" id="email" required />

    <label for="location">Location:</label>
    <input type="text" name="location" id="location" required />

    <button type="submit">Add</button>
  </form>
</body>


</html>