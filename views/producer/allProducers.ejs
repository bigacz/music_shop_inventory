<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>All producers</title>

  <script src="/scripts/producer/allProducers.js" defer></script>
  <link rel="stylesheet" href="/style/producer/allProducers.css">


</head>

<body>
  <%- include('../components/navbar.ejs') %>
  <div>
    <h2>All producers:</h2>
    <table>
      <thead>
        <tr>
          <th class="table__header-number">No.</th>
          <th class="table__header-generic">Producer</th>
          <th class="table__header-generic">Location</th>
          <th class="table__header-generic">Contact</th>
          <th class="table__header-delete">Delete</th>
          <th>Edit</th>

        </tr>
      </thead>
      <tbody>
        <% producers.map((producer, index) => { %>
        <tr>
          <td><%= index + 1 %></td>

          <td> <a href="producers/<%= producer.producer_id %>"><%= producer.producer_name %></a> </td>
          <td> <%= producer.location %> </td>
          <td> <%= producer.email %> </td>
          <td class="table__delete-cell"> <button data-producer-id="<%=producer.producer_id%>"><img src="/assets/delete.svg" alt="Delete"></button> </td>
          <td class="table__edit-cell">
            <a href="/producers/<%=producer.producer_id%>/edit"><img src="/assets/cog.svg" alt="Edit"></a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

</body>

</html>